# Xcode
DerivedData/
build/
*.xcuserstate
xcuserdata/

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store

# Claude Code machine-local preferences
CLAUDE.local.md
.claude/settings.local.json

# Large rendered demo video. Kept on disk, not in history — a 36 MB binary is
# expensive to carry forever and awkward to remove once pushed. The Demo/
# source frames and assets that produce it stay tracked.
Demo/Speak-It-Product-Demo.mp4

# Deterministic marketing renders and their redundant delivery archive.
Marketing/TikTokSlideshows/output/
Marketing/SpeakIt-TikTok-UGC-Slideshows.zip

# Signing material and local credentials.
*.p8
*.pem
*.mobileprovision

# Rendered exports and scratch working files. Same reasoning as the demo video
# above: these are hundreds of megabytes of generated artefacts, cheap to
# regenerate and expensive to carry in history forever.
output/
tmp/

# Xcode result bundles and archives written by the Tools/CI scripts.
*.xcresult
*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip

# Node projects (FounderDashboard, ReferralService). Each has its own
# .gitignore; these repeat the essentials so a stray install elsewhere in the
# tree is never committed.
node_modules/
.env
.env.*
!.env.example
.dev.vars

# Python scratch (Demo/create_contact_sheet.py, Website/tools).
__pycache__/
*.pyc
